{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnchorBlueprint",
  "type": "object",
  "required": ["version", "anchors"],
  "properties": {
    "version": { "type": "string" },
    "anchors": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/anchor" }
    }
  },
  "definitions": {
    "anchor": {
      "type": "object",
      "required": ["id", "category", "max_players", "slots", "completion_effects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z_]+$" },
        "display_name": {
          "type": "object",
          "required": ["en"],
          "properties": {
            "en": { "type": "string", "minLength": 1 },
            "ar": { "type": "string", "minLength": 1 }
          }
        },
        "category": { "enum": ["primary", "secondary", "decoration"] },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_players": { "type": "integer", "minimum": 1, "maximum": 8 },
        "snap_grid": { "type": "number", "minimum": 0.1, "maximum": 5.0 },
        "footprint_cells": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number", "minimum": 1 },
            "y": { "type": "number", "minimum": 1 },
            "z": { "type": "number", "minimum": 1 }
          }
        },
        "cooperation_required": { "type": "boolean" },
        "min_players_building": { "type": "integer", "minimum": 1 },
        "completion_time_seconds": { "type": "integer", "minimum": 10 },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/definitions/slot" }
        },
        "completion_effects": {
          "type": "object",
          "required": ["vfx"],
          "properties": {
            "scene_clear": { "type": "boolean" },
            "vfx": { "type": "string" },
            "audio": { "type": "string" },
            "score_award": { "type": "integer", "minimum": 0 },
            "trigger_outcome": { "type": "string" }
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "required": ["slot_id", "position", "valid_shards", "weight"],
      "properties": {
        "slot_id": { "type": "string", "pattern": "^[a-z_]+$" },
        "position": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "rotation_deg": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "shape_hint": { "type": "string" },
        "material_hint": { "type": "string" },
        "preferred_timeline": { "enum": ["past", "present", "future", "neutral"] },
        "owner_index_required": { "type": "integer", "minimum": 0, "maximum": 7 },
        "valid_shards": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "weight": { "type": "number", "minimum": 0 },
        "visual_marker": { "type": "string" }
      }
    }
  }
}