{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultiplayerProtocolSchema",
  "type": "object",
  "required": ["type", "payload", "timestamp", "seq"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "JOIN_ROOM_REQUEST",
        "JOIN_ROOM_SUCCESS",
        "JOIN_ROOM_FAILED",
        "PLAYER_READY",
        "MATCH_START",
        "PLAYER_INTENT",
        "ECHO_PROPAGATED",
        "STATE_DELTA",
        "STATE_SNAPSHOT",
        "SEMANTIC_PING",
        "SEMANTIC_QUICK_MSG",
        "CATASTROPHE_UPDATE",
        "MATCH_CONCLUDED",
        "RECONNECT_REQUEST",
        "RECONNECT_SUCCESS",
        "HEARTBEAT",
        "HEARTBEAT_ACK",
        "PLAYER_DISCONNECTED",
        "PLAYER_RECONNECTED"
      ]
    },
    "seq": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "integer" },
    "sender_id": { "type": "string" },
    "timeline": { "type": "string", "enum": ["past", "present", "future", "system"] },
    "payload": { "type": "object" }
  }
}
