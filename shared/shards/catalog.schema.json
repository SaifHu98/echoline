{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShardCatalog",
  "type": "object",
  "required": ["version", "rules", "shards"],
  "properties": {
    "version": { "type": "string" },
    "rules": {
      "type": "object",
      "required": ["drop_rate_base", "cooperation_bonus"],
      "properties": {
        "drop_rate_base": { "type": "number", "minimum": 0, "maximum": 1 },
        "drop_rate_cap": { "type": "number", "minimum": 0, "maximum": 1 },
        "cooperation_bonus": { "type": "number", "minimum": 0, "maximum": 1 },
        "duplicate_conversion": { "type": "integer", "minimum": 2 },
        "rare_shard_unlock_match": { "type": "integer", "minimum": 1 }
      }
    },
    "shards": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/shard" }
    }
  },
  "definitions": {
    "shard": {
      "type": "object",
      "required": ["id", "timeline", "tier", "weight"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z_]+$" },
        "timeline": { "enum": ["past", "present", "future", "neutral"] },
        "tier": { "enum": ["common", "rare", "epic", "legendary"] },
        "display_name": {
          "type": "object",
          "required": ["en"],
          "properties": {
            "en": { "type": "string", "minLength": 1 },
            "ar": { "type": "string", "minLength": 1 }
          }
        },
        "lore": {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "ar": { "type": "string" }
          }
        },
        "shape": { "enum": ["rounded", "plank", "ring", "box", "flat", "gear", "hex", "sphere", "marker"] },
        "material": { "enum": ["stone", "wood", "iron", "steel", "glass", "brass", "crystal", "energy"] },
        "emissive_color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
        "weight": { "type": "number", "minimum": 0 },
        "drop_sources": { "type": "array", "items": { "type": "string" } },
        "use_in": { "type": "array", "items": { "type": "string" } },
        "drop_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "icon": { "type": "string" },
        "sound_pickup": { "type": "string" },
        "vfx_appear": { "type": "string" }
      }
    }
  }
}