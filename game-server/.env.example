# ECHO//LINE — Game Server Configuration
PORT=3000
NODE_ENV=production

# CORS — add your Hostinger domain
ALLOWED_ORIGINS=*

# Hostinger Admin API — pulls remote config, events, quests, shop
ADMIN_API_URL=https://yourdomain.com/admin/api.php
ADMIN_API_KEY=

# Server limits
MAX_ROOMS=200
MAX_PLAYERS_PER_ROOM=4
MATCH_DURATION_SECONDS=600
DISCONNECT_GRACE_SECONDS=30

# Logging
LOG_LEVEL=info

# Persistence (in-memory by default; can be upgraded to Redis)
USE_REDIS=false
REDIS_URL=